{
  "id": "home-assistant",
  "source": "ha",
  "name": "Home Assistant",
  "version": "1.8.0",
  "minAgent": "1.12.0",
  "sdk": 16,
  "entry": "plugin.js",
  "permissions": {
    "net": [
      "setting:url"
    ],
    "notifications": true
  },
  "actions": {
    "toggle": {
      "label": "HA: переключить", "title": "Переключить", "icon": "lightbulb", "kind": "toggle",
      "params": [
        { "key": "entity", "type": "string", "label": "Что переключать — свет, розетка, вентилятор, шторы", "required": true,
          "editor": { "type": "autocomplete", "options": "findSwitchable" } }
      ]
    },
    "turn_on": {
      "label": "HA: включить", "title": "Включить", "icon": "power",
      "params": [
        { "key": "entity", "type": "string", "label": "Что включать", "required": true,
          "editor": { "type": "autocomplete", "options": "findSwitchable" } }
      ]
    },
    "turn_off": {
      "label": "HA: выключить", "title": "Выключить", "icon": "power",
      "params": [
        { "key": "entity", "type": "string", "label": "Что выключать", "required": true,
          "editor": { "type": "autocomplete", "options": "findSwitchable" } }
      ]
    },
    "run": {
      "label": "HA: сцена, сценарий или кнопка", "title": "Запуск", "icon": "sparkle",
      "params": [
        { "key": "entity", "type": "string", "label": "Сцена, сценарий или кнопка", "required": true,
          "editor": { "type": "autocomplete", "options": "findRunnable" } }
      ]
    }
  },
  "settings": [
    {
      "key": "url",
      "type": "string",
      "label": "Адрес сервера",
      "required": true
    },
    {
      "key": "auth",
      "type": "oauth",
      "label": "Вход через браузер",
      "oauth": {
        "urlFrom": "url",
        "authorize": "/auth/authorize",
        "token": "/auth/token",
        "pkce": false
      }
    },
    {
      "key": "token",
      "type": "secret",
      "label": "Long-lived токен (вместо входа)"
    },
    {
      "key": "bindings",
      "type": "list",
      "of": "object",
      "label": "Сущности",
      "editor": {
        "type": "picker",
        "options": "listEntities",
        "multi": true,
        "live": true,
        "test": "checkConnection",
        "assign": {
          "id": "entities",
          "label": "label",
          "unit": "unit"
        }
      },
      "fields": [
        {
          "key": "entities",
          "type": "string",
          "label": "Сущности (через запятую)",
          "required": true,
          "editor": {
            "type": "autocomplete",
            "options": "listEntities"
          }
        },
        {
          "key": "card",
          "type": "select",
          "label": "Карточка",
          "options": [
            {
              "value": "auto",
              "label": "авто"
            },
            {
              "value": "gauge",
              "label": "gauge — значение"
            },
            {
              "value": "meters",
              "label": "meters — мини-бары"
            },
            {
              "value": "status",
              "label": "status — вкл/выкл"
            }
          ]
        },
        {
          "key": "label",
          "type": "string",
          "label": "Подпись"
        },
        {
          "key": "unit",
          "type": "string",
          "label": "Единица",
          "showWhen": {
            "field": "card",
            "in": [
              "gauge",
              "auto"
            ]
          }
        },
        {
          "key": "min",
          "type": "number",
          "label": "Шкала: мин",
          "showWhen": {
            "field": "card",
            "in": [
              "gauge",
              "auto"
            ]
          }
        },
        {
          "key": "max",
          "type": "number",
          "label": "Шкала: макс",
          "showWhen": {
            "field": "card",
            "in": [
              "gauge",
              "auto"
            ]
          }
        },
        {
          "key": "title",
          "type": "string",
          "label": "Заголовок",
          "showWhen": {
            "field": "card",
            "in": [
              "meters"
            ]
          }
        },
        {
          "key": "badgeOn",
          "type": "string",
          "label": "Бейдж ВКЛ",
          "showWhen": {
            "field": "card",
            "in": [
              "status"
            ]
          }
        },
        {
          "key": "badgeOff",
          "type": "string",
          "label": "Бейдж ВЫКЛ",
          "showWhen": {
            "field": "card",
            "in": [
              "status"
            ]
          }
        }
      ]
    }
  ]
}
