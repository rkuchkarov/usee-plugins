{
  "id": "weather",
  "name": "Погода",
  "version": "1.2.0",
  "minAgent": "1.7.0",
  "sdk": 11,
  "entry": "plugin.js",
  "permissions": {
    "net": ["*.open-meteo.com"]
  },
  "settings": [
    { "key": "units", "type": "select", "label": "Единицы", "default": "metric",
      "options": [
        { "value": "metric", "label": "°C · м/с" },
        { "value": "imperial", "label": "°F · mph" }
      ] },
    { "key": "intervalMin", "type": "number", "label": "Обновлять раз в N минут",
      "default": 15, "min": 1, "max": 240 }
  ],
  "instances": {
    "label": "Город",
    "settings": [
      { "key": "city", "type": "string", "label": "Город", "required": true,
        "editor": { "type": "autocomplete", "options": "searchCity" } }
    ]
  }
}
