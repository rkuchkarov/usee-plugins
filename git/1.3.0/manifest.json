{
  "id": "git",
  "name": "Git",
  "version": "1.3.0",
  "minAgent": "1.7.0",
  "sdk": 11,
  "entry": "plugin.js",
  "permissions": {},
  "exec": [
    { "id": "status",
      "run": "git",
      "args": ["-C", "{repo}", "status", "--porcelain=v2", "--branch"],
      "vars": { "repo": { "type": "path", "under": "setting:repoPath" } } },
    { "id": "diffstat",
      "run": "git",
      "args": ["-C", "{repo}", "diff", "--numstat", "HEAD"],
      "vars": { "repo": { "type": "path", "under": "setting:repoPath" } } },
    { "id": "last-commit",
      "run": "git",
      "args": ["-C", "{repo}", "log", "-1", "--format=%ct\t%h\t%s"],
      "vars": { "repo": { "type": "path", "under": "setting:repoPath" } } }
  ],
  "settings": [
    { "key": "intervalSec", "type": "number", "label": "Опрос раз в N секунд",
      "default": 10, "min": 2, "max": 300 }
  ],
  "instances": {
    "label": "Репозиторий",
    "settings": [
      { "key": "repoPath", "type": "string", "label": "Папка репозитория", "required": true,
        "editor": { "type": "folder", "options": "%USERPROFILE%\\source;%USERPROFILE%\\projects;~/projects;{wsl:projects}" } }
    ]
  },
  "preview": [
    { "card": "branch", "type": "status",
      "data": {
        "icon": "git-branch",
        "line1": "main",
        "line2": "+128 −42 · 6 файл.  ↑2",
        "badge": "+128 −42",
        "badgeKind": "accent",
        "detail": "787149f · feat: plugin redesign",
        "eventAt": 1731110000
      } },
    { "card": "files", "type": "meters",
      "data": {
        "title": "GIT · ИЗМЕНЕНИЯ",
        "rows": [
          { "label": "plugin.js", "label16": "plugins/git/plugin.js", "pct": 100, "sec": "+96 −14" },
          { "label": "README.md", "label16": "plugins/git/README.md", "pct": 46, "sec": "+28 −12" },
          { "label": "manifest.json", "label16": "plugins/git/manifest.json", "pct": 16, "sec": "+14 −2" }
        ],
        "footer": "всего: +138 −28 · 3 файл."
      } }
  ]
}
