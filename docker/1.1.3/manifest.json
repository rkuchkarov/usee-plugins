{
  "id": "docker",
  "name": "Docker",
  "version": "1.1.3",
  "minAgent": "1.5.0",
  "sdk": 8,
  "entry": "plugin.js",
  "permissions": {
    "pipe": ["docker_engine"],
    "net": ["setting:endpoint"]
  },
  "settings": [
    { "key": "endpoint", "type": "string",
      "label": "TCP-адрес демона (пусто = именованный пайп)",
      "section": "Подключение" },
    { "key": "metric", "type": "select", "label": "Показатель в мини-барах", "default": "cpu",
      "options": [
        { "value": "cpu", "label": "CPU %" },
        { "value": "mem", "label": "RAM %" }
      ] },
    { "key": "label", "type": "string", "label": "Подпись (по умолчанию — Docker)" },
    { "key": "intervalSec", "type": "number", "label": "Опрос раз в N секунд",
      "default": 5, "min": 2, "max": 300 }
  ],
  "preview": [
    { "card": "docker", "type": "status",
      "data": {"icon": "containers", "line1": "DOCKER", "line2": "3 / 5 контейнеров", "badge": "3", "badgeKind": "accent"} },
    { "card": "stats", "type": "meters",
      "data": {"title": "DOCKER · CPU %", "rows": [{"label": "postgres", "pct": 34}, {"label": "redis", "pct": 12}, {"label": "nginx", "pct": 4}]} }
  ]
}
