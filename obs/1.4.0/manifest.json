{
  "id": "obs",
  "name": "OBS Studio",
  "version": "1.4.0",
  "minAgent": "1.5.0",
  "sdk": 8,
  "entry": "plugin.js",
  "permissions": {
    "net": [
      "setting:host"
    ],
    "notifications": true
  },
  "settings": [
    {
      "key": "host",
      "type": "string",
      "label": "Адрес OBS (host)",
      "required": true,
      "default": "127.0.0.1",
      "section": "Подключение"
    },
    {
      "key": "port",
      "type": "number",
      "label": "Порт obs-websocket",
      "default": 4455,
      "min": 1,
      "max": 65535,
      "section": "Подключение"
    },
    {
      "key": "password",
      "type": "secret",
      "label": "Пароль WebSocket-сервера (если задан)",
      "section": "Подключение"
    },
    {
      "type": "info",
      "text": "OBS 30.2+: Tools → WebSocket Server Settings → Enable WebSocket Server"
    },
    {
      "key": "toasts",
      "type": "bool",
      "label": "Тосты о записи и эфире",
      "default": true,
      "section": "Карточки"
    },
    {
      "key": "micInput",
      "type": "string",
      "label": "Вход микрофона (пусто — выберу сам)",
      "section": "Карточки",
      "editor": {
        "type": "autocomplete",
        "options": "listInputs"
      }
    },
    {
      "type": "info",
      "text": "пусто — спец. вход Mic/Aux или единственный вход захвата"
    }
  ]
}
