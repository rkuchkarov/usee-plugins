{
  "id": "pomodoro",
  "name": "Помодоро",
  "version": "1.2.2",
  "minAgent": "1.15.0",
  "sdk": 18,
  "entry": "plugin.js",
  "actions": {
    "toggle": { "label": "Помодоро: старт или пауза", "title": "Помодоро", "icon": "timer", "kind": "toggle" },
    "reset": { "label": "Помодоро: сброс", "title": "Сброс", "icon": "arrow-clockwise", "dangerous": true },
    "plus": { "label": "Помодоро: плюс минуты", "title": "Плюс минуты", "icon": "hourglass" },
    "skip": { "label": "Помодоро: пропустить фазу", "title": "Пропустить", "icon": "skip-forward" }
  },
  "settings": [
    {
      "key": "focusMin",
      "type": "number",
      "label": "Фокус, мин",
      "default": 25,
      "min": 1,
      "max": 180,
      "section": "Длительности"
    },
    {
      "key": "breakMin",
      "type": "number",
      "label": "Отдых, мин",
      "default": 5,
      "min": 1,
      "max": 60,
      "section": "Длительности"
    },
    {
      "key": "longMin",
      "type": "number",
      "label": "Долгий отдых, мин",
      "default": 15,
      "min": 1,
      "max": 120,
      "section": "Длительности"
    },
    {
      "key": "rounds",
      "type": "number",
      "label": "Раундов до долгого отдыха",
      "default": 4,
      "min": 1,
      "max": 8,
      "section": "Длительности"
    },
    {
      "key": "plusMin",
      "type": "number",
      "label": "Сколько минут добавляет «плюс»",
      "default": 5,
      "min": 1,
      "max": 60,
      "section": "Длительности"
    },
    {
      "key": "notify",
      "type": "bool",
      "label": "Во весь экран: конец фазы и отдых",
      "default": true,
      "section": "Во весь экран"
    },
    {
      "key": "autoBreak",
      "type": "bool",
      "label": "Отдых начинается сам",
      "default": true,
      "section": "Во весь экран"
    },
    {
      "key": "autoFocus",
      "type": "bool",
      "label": "Фокус начинается сам",
      "default": false,
      "section": "Во весь экран"
    },
    {
      "key": "autoSec",
      "type": "number",
      "label": "Через сколько секунд — автостарт (отсчёт в карточке)",
      "default": 15,
      "min": 3,
      "max": 120,
      "section": "Во весь экран"
    },
    {
      "key": "holdSec",
      "type": "number",
      "label": "Сколько ждать ответа после конца фазы, с",
      "default": 60,
      "min": 10,
      "max": 600,
      "section": "Во весь экран"
    },
    {
      "type": "info",
      "text": "Фокус дотикал — карточка раскрывается во весь экран: отсчёт до отдыха, затем отдых. Запуск фокуса сворачивает её в своё место; свернуть руками — смахнуть вниз.\nЖестов у карточки нет: касание раскрывает её во весь экран. Старт, пауза, плюс минуты, пропуск и сброс — кнопками помодоро в сцене или в шторке."
    }
  ],
  "preview": [
    { "card": "timer", "type": "timer",
      "data": {"tone": "red", "word": "Фокус", "mode": "pause", "durSec": 1500, "left": 817, "rounds": 4, "done": 1,
               "current": true, "at": {"word": "отдых в", "time": "14:30"}, "today": {"count": 3, "text": "1 ч 15"},
               "week": [0.55, 0.8, 0.4, 0.95, 0.7, 0.25, 0.6]} }
  ]
}
