{
  "id": "discord",
  "name": "Discord",
  "version": "1.2.1",
  "minAgent": "1.3.0",
  "sdk": 3,
  "entry": "plugin.js",
  "permissions": {
    "pipe": ["discord-ipc-*"],
    "net": ["discord.com", "cdn.discordapp.com"],
    "notifications": true
  },
  "settings": [
    { "key": "notifyJoin", "type": "bool", "label": "Уведомлять о входе в созвон", "default": true }
  ],
  "preview": [
    { "card": "voice", "type": "voice",
      "data": {"label": "ГОЛОС", "members": [{"mono": "АК", "name": "Алексей", "speaking": true}, {"mono": "МД", "name": "Маша"}, {"mono": "ИЛ", "name": "Илья"}]} }
  ]
}
